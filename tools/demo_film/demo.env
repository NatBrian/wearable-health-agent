# The demo film's environment. Loaded by tools/demo_film/*, never by `wha serve`.
#
# WHA_CLOCK_OFFSET_DAYS is deliberately NOT set here. build.py computes it per day and
# clears it when it exits, so a stray value cannot outlive a run and quietly date
# production rows into the future.
WHA_DB_PATH=data/demo_film.sqlite
WHA_SUBJECT=demo
WHA_TIMEZONE=Asia/Singapore
WHA_MOCK_STATE=data/demo_film_state.json
WHA_BRIDGE_URL=http://127.0.0.1:8788
