# --- Data. Never commit wearable datasets or personal health data. ---
# NOTE: data/ is ignored by CONTENT, not as a directory, because
# data/knowledge/ holds the authored, cited knowledge tables and MUST be committed.
data/*
!data/knowledge/
data/knowledge/*.sqlite
datasets/
raw/
*.zip
*.tar
*.tar.gz
*.parquet
*.sqlite
*.db
# Personal exports (Samsung Health / WHOOP / Oura). These are personal health data.
personal/
exports/

# --- Secrets ---
.env
.env.*
!.env.example
*.key
*.pem
secrets.*
credentials.*
token*.json

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
env/
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# --- Model / LLM caches ---
.cache/
hf_cache/
llm_cache/
*.ckpt
*.safetensors

# --- OS / editor ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp

# synthetic samples
syn.json
*.sample.json

# Playwright MCP artifacts and ad-hoc screenshots taken at the repository root.
# docs/screenshots/ is committed deliberately and is not covered by this.
.playwright-mcp/
/screenshot_*.png
view_db.py
seed_*.py

# Mock watch simulation cursor (tools/mock_watch.py)
data/sim_state.json

# Local run logs from `wha serve` and the mock watch.
serve.log
mockwatch.log

# --- Review session scratch space (analysis scripts, downloaded cohort data, notes). ---
# Not part of the product. Nothing here is imported by src/.
scratch/

# --- The demo film's intermediates. ---
# Regenerated by tools/demo_film/assemble.py from the cards, the footage and the script,
# so they are derived files rather than sources. The finished mp4, its chapter list and
# its captions ARE committed, because those are the deliverable.
docs/demo/work/
docs/demo/footage-raw/
data/demo_film.sqlite
data/demo_film_live.sqlite
data/demo_film_state.json
data/demo-snapshots/
