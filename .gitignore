# --- Data. Never commit wearable datasets or personal health data. ---
# NOTE: data/ is ignored by CONTENT, not as a directory, because
# data/knowledge/ holds the authored, cited knowledge tables and MUST be committed.
data/*
!data/knowledge/
data/knowledge/*.sqlite
datasets/
raw/
*.zip
*.tar
*.tar.gz
*.parquet
*.sqlite
*.db
# Personal exports (Samsung Health / WHOOP / Oura). These are personal health data.
personal/
exports/

# --- Secrets ---
.env
.env.*
!.env.example
*.key
*.pem
secrets.*
credentials.*
token*.json

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
env/
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# --- Model / LLM caches ---
.cache/
hf_cache/
llm_cache/
*.ckpt
*.safetensors

# --- OS / editor ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp

# synthetic samples
syn.json
*.sample.json

# Playwright MCP artifacts and ad-hoc screenshots taken at the repository root.
# docs/screenshots/ is committed deliberately and is not covered by this.
.playwright-mcp/
/screenshot_*.png
view_db.py
seed_*.py

# Mock watch simulation cursor (tools/mock_watch.py)
data/sim_state.json

# Local run logs from `wha serve` and the mock watch.
serve.log
mockwatch.log

# --- Review session scratch space. Deleted 7 September 2026; kept ignored in case a
# future session recreates one. Nothing here is ever imported by src/.
scratch/

# --- The demo film's intermediates. ---
# Derived files, regenerated by tools/demo_film/assemble.py from the cards, the footage
# and the script. The finished mp4, its chapter list and its captions ARE committed,
# because those are the deliverable.
docs/demo/work/
docs/demo/footage-raw/

# The working copy tools/demo_film/serve_demo.py makes so that browsing the timeline
# cannot alter the committed one. Delete it to start again from the film's state.
data/demo_film_live.sqlite

# The per-day snapshots, about 300 MB. Not committed because of the size, and because the
# finished database below is what anybody actually needs to look at the timeline. They are
# only required to RE-FILM a single day, and re-creating them costs model calls and would
# produce different wording, so if the ones on disk matter to you, commit them.
data/demo-snapshots/

# NOT ignored, on purpose: data/demo_film.sqlite and data/demo_film_state.json.
# The finished timeline is the point of the demo. Re-running the build would cost model
# calls and would produce different text, so this database is not reproducible and is
# committed rather than regenerated.

# Claude Code's own working directory, including any git worktrees it creates under
# .claude/worktrees/. Those are full checkouts with their own .venv and run to gigabytes.
# Nothing here belongs to the project.
.claude/

# Short-lived implementation worktrees used by Codex.
.worktrees/
