# Storage
WHA_DB_PATH=data/wha.sqlite

# Subject & Timezone
WHA_SUBJECT=me
WHA_TIMEZONE=Asia/Singapore

# Health Connect Bridge
WHA_BRIDGE_HOST=192.168.1.100
WHA_BRIDGE_PORT=8787
WHA_BRIDGE_TOKEN=placeholder_bridge_token

# LLM Provider: cassette (default), ollama_native, or openai_compatible
WHA_LLM_PROVIDER=cassette
WHA_LLM_BASE_URL=https://api.openai.com/v1
WHA_LLM_API_KEY=placeholder_api_key
WHA_LLM_MODEL=deepseek-v3.2
WHA_CASSETTE_DIR=tests/fixtures/llm_cassettes

# Notifications
WHA_TELEGRAM_TOKEN=placeholder_telegram_token
WHA_TELEGRAM_CHAT_ID=placeholder_telegram_chat_id
WHA_NOTIFY_CHANNEL=none

# Datasets
WHA_DATA_DIR=data/datasets
